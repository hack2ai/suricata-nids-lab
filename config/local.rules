# NIDS LAB - Educational Suricata rules
# These signatures are intentionally simple training rules for an isolated lab.
# The rules below reflect the syntax used successfully during Suricata 8.0.3 validation.
# Keep them separate from downloaded rule sets.

# TCP SYN scan / reconnaissance training detector
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible TCP SYN Scan"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# Web command-injection training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible Command Injection"; http.uri; content:"cmd-lab"; nocase; sid:1000010; rev:1;)

# Directory traversal training marker.
# Uses the raw URI because the verified lab test used URL-encoded ../ (%2E%2E%2F).
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible Directory Traversal"; content:"%2e%2e%2f"; nocase; http_raw_uri; sid:1000011; rev:4;)

# XSS training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible XSS Marker"; http.uri; content:"xss-lab"; nocase; sid:1000012; rev:2;)

# SQL injection training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible SQL Injection"; http.uri; content:"sql-lab"; nocase; sid:1000013; rev:1;)

# File inclusion training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible File Inclusion"; http.uri; content:"include-lab"; nocase; sid:1000014; rev:1;)
