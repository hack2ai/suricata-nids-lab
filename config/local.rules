# NIDS LAB - Educational Suricata rules
# These signatures are intentionally simple training rules for an isolated lab.
# Keep them separate from downloaded rule sets.

# TCP SYN scan / reconnaissance training detector
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible TCP SYN Scan"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# Harmless Metasploit-related training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Metasploit Training Marker"; flow:established,to_server; http.uri; content:"msf-lab-test"; sid:1000002; rev:1;)

# Web command-injection training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible Command Injection"; flow:established,to_server; http.uri; content:"cmd-lab"; nocase; sid:1000010; rev:1;)

# Directory traversal training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible Directory Traversal"; flow:established,to_server; http.uri; content:"../"; sid:1000011; rev:1;)

# XSS training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible XSS Marker"; flow:established,to_server; http.uri; content:"xss-lab"; nocase; sid:1000012; rev:1;)

# SQL injection training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible SQL Injection"; flow:established,to_server; http.uri; content:"sql-lab"; nocase; sid:1000013; rev:1;)

# File inclusion training marker
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NIDS LAB Possible File Inclusion"; flow:established,to_server; http.uri; content:"include-lab"; nocase; sid:1000014; rev:1;)
